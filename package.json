{
  "name": "@sfplabs/circadian",
  "version": "1.0.0",
  "description": "Location-aware solar phase values, colors, and gradients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
